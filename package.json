{
  "name": "@0x5278/copium",
  "version": "1.0.0",
  "description": "100% free, no-account, no-subscription coding agent for the terminal",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "bin": {
    "copium": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src test --ext .ts",
    "format": "bunx prettier --write src test",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "ai",
    "coding agent",
    "cli",
    "tui",
    "openrouter",
    "ollama",
    "local",
    "free"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyKoch1/Copium.git"
  },
  "bugs": {
    "url": "https://github.com/JoeyKoch1/Copium/issues"
  },
  "homepage": "https://github.com/JoeyKoch1/Copium#readme"
}
